
#1. Install required packages

sudo apt-get update
sudo apt-get install -y fastp bowtie2 kraken2 seqtk wget unzip git


#2. Fetch example FASTQ
wget https://raw.githubusercontent.com/toryn13/metatranscriptome_example/refs/heads/main/SRR8291356_1_sub.fastq


#3. Trim reads with fastp

fastp -i SRR8291356_1_sub.fastq -o trimmed.fastq --thread 4


# 4. Remove host reads (mouse mm10)
wget https://genome-idx.s3.amazonaws.com/bt/mm10.zip
unzip mm10.zip

bowtie2 -x mm10 -U trimmed.fastq --un host_removed.fastq -S /dev/null 2> bowtie2_stats.txt

# host_removed.fastq now contains non-mouse reads

# 5. Download MiniKraken2

mkdir -p k2db
wget https://genome-idx.s3.amazonaws.com/kraken/k2_standard_8gb_20220926.tar.gz
tar -xvzf k2_standard_8gb_20220926.tar.gz -C k2db


#6. Classify reads with Kraken2

kraken2 --db k2db \
        --report sample.k2report \
        --minimum-hit-groups 3 \
        host_removed.fastq > sample.kraken2


#7. Summarize abundances with Bracken

git clone https://github.com/jenniferlu717/Bracken.git
cd Bracken/src/
make
cd ../../

#Bracken run
sudo ln -s $(which python3) /usr/bin/python

cd ~/Bracken
./bracken -d ~/k2db -i ~/sample.k2report -o sample.bracken -l S



